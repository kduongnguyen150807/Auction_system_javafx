<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" stylesheets="@/css/youritem/YourItem.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.ui.YourItem.YourItemController">
    <content>
        <VBox alignment="TOP_CENTER" style="-fx-background-color: transparent;">
            <children>
                <VBox maxWidth="1000.0" spacing="30.0" styleClass="glass-panel-item">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label styleClass="Bigtext" text="Hàng Của Tôi" />
                                        <Label styleClass="Smalltext" text="Quản lý các sản phẩm bạn đã đăng bán" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#refreshItems" styleClass="btn-refresh" text="Làm mới" />
                            </children>
                        </HBox>
                        <HBox spacing="20.0">
                            <children>
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-title" text="ĐANG ĐẤU GIÁ" />
                                        <Label fx:id="ActiveItemsValue" styleClass="stat-value" text="0" />
                                    </children>
                                </VBox>
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-title" text="TỔNG GIÁ TRỊ" />
                                        <Label fx:id="InventoryValue" styleClass="stat-value" text="0$" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <VBox spacing="15.0">
                            <children>
                                <Label styleClass="section-title" text="Danh sách sản phẩm" />
                                <FlowPane fx:id="ItemContainer" hgap="20.0" vgap="20.0" />
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="40.0" top="40.0" />
                    </VBox.margin>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>