<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            stylesheets="/css/iteminformation/ItemInformation.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.ui.ItemInformation.ItemInformationController">
    <content>
        <VBox alignment="TOP_CENTER" styleClass="main-scroll-root">
            <children>
                <HBox alignment="CENTER" spacing="50.0" styleClass="glass-panel-info" maxWidth="1200.0">
                    <children>
                        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox styleClass="img-frame-mac">
                                    <children>
                                        <ImageView fx:id="ItemImageHolder" fitHeight="500.0" fitWidth="500.0" pickOnBounds="true" preserveRatio="true" />
                                    </children>
                                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER_LEFT" maxWidth="550.0" minWidth="450.0" spacing="22.0" HBox.hgrow="SOMETIMES">
                            <children>
                                <Label fx:id="ItemName" styleClass="item-title-glow" text="Hugo" wrapText="true" />

                                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="seller-box-mac">
                                    <children>
                                        <ImageView fx:id="SellerAvatar" fitHeight="50.0" fitWidth="50.0" pickOnBounds="true">
                                            <clip><Circle centerX="25" centerY="25" radius="25" /></clip>
                                        </ImageView>
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="label-sm-gray" text="SELLER" />
                                                <Label fx:id="SellerName" styleClass="seller-name-blue" text="Unknown Seller" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox spacing="8.0">
                                    <children>
                                        <Label styleClass="label-sm-gray" text="DESCRIPTION" />
                                        <Label fx:id="ItemDescription" styleClass="desc-text-mac" text="Tuổi thơ dữ dội..." wrapText="true" />
                                    </children>
                                </VBox>

                                <HBox alignment="CENTER_LEFT" spacing="40.0">
                                    <children>
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label fx:id="BidMetricCaption" styleClass="label-sm-gray" text="CURRENT BID" />
                                                <Label fx:id="CurrentHighestBidValue" styleClass="price-val-blue" text="7,000,000$" />
                                            </children>
                                        </VBox>
                                        <VBox fx:id="buyItNowVBox" spacing="5.0">
                                            <children>
                                                <Label styleClass="label-sm-gray" text="BUY IT NOW" />
                                                <Label fx:id="MaxPriceValue" styleClass="price-val-white" text="NO BUY IT NOW" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label styleClass="label-sm-gray" text="ENDS IN" />
                                        <Label fx:id="EndsInValue" styleClass="timer-val-glow" text="22h 12m" />
                                    </children>
                                </VBox>

                                <Button fx:id="BidButton" maxWidth="Infinity" onAction="#showBiddingForm" prefHeight="60.0" styleClass="btn-bid-main" text="PLACE BID NOW" />

                                <HBox fx:id="autoBidHBox" spacing="10" alignment="CENTER">
                                    <children>
                                        <TextField fx:id="autobidfield" promptText="Max Auto-Bid $" styleClass="input-mac-blue" prefHeight="45.0" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="autobidbutton" onAction="#handleAutoBid" prefHeight="45.0" prefWidth="120.0" text="AUTO BID" styleClass="btn-rounded-gold-sm" />
                                    </children>
                                </HBox>

                                <Button fx:id="RateButton" maxWidth="Infinity" onAction="#showRatingForm" prefHeight="50.0" text="RATE THIS TRANSACTION" visible="false" managed="false" styleClass="btn-rounded-gold-sm" />

                                <VBox fx:id="RatingsContainer" spacing="8.0" visible="false" managed="false">
                                    <children>
                                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="RATINGS" styleClass="label-sm-gray" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <ComboBox fx:id="RatingFilterCombo" onAction="#handleRatingFilter" prefWidth="130" styleClass="combo-mac-sm" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="10.0">
                                    <children>
                                        <Label text="REAL-TIME PRICE CURVE" styleClass="label-sm-gray" />
                                        <LineChart fx:id="pricechart" prefHeight="220.0" animated="false" styleClass="chart-glass">
                                            <xAxis><CategoryAxis side="BOTTOM" tickLabelFill="WHITE" /></xAxis>
                                            <yAxis><NumberAxis side="LEFT" tickLabelFill="WHITE" /></yAxis>
                                        </LineChart>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                    <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
                </HBox>
            </children>
            <padding><Insets bottom="50.0" top="50.0" /></padding>
        </VBox>
    </content>
</ScrollPane>