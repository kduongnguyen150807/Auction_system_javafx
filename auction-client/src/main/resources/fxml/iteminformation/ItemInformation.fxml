<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER" styleClass="main-scroll-pane" stylesheets="@/css/iteminformation/ItemInformation.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.ui.ItemInformation.ItemInformationController">
    <content>
        <HBox alignment="CENTER" spacing="40.0" styleClass="main-container">
            <children>
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                    <children>
                        <ImageView fx:id="ItemImageHolder" fitHeight="550.0" fitWidth="550.0" pickOnBounds="true" preserveRatio="true" />
                    </children>
                </VBox>

                <VBox alignment="CENTER_LEFT" maxWidth="550.0" minWidth="450.0" spacing="25.0" HBox.hgrow="SOMETIMES">
                    <children>
                        <Label fx:id="ItemName" styleClass="title-label" text="Hugo" wrapText="true" />

                        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="seller-box">
                            <children>
                                <ImageView fx:id="SellerAvatar" fitHeight="50.0" fitWidth="50.0" pickOnBounds="true">
                                    <clip>
                                        <Circle centerX="25" centerY="25" radius="25" />
                                    </clip>
                                </ImageView>
                                <VBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label styleClass="label-small" text="SELLER" />
                                        <Label fx:id="SellerName" styleClass="seller-name-label" text="Unknown Seller" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="label-small" text="DESCRIPTION" />
                                <Label fx:id="ItemDescription" styleClass="description-text" text="Tuổi thơ dữ dội..." wrapText="true" />
                            </children>
                        </VBox>

                        <VBox spacing="20.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="50.0">
                                    <children>
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label styleClass="label-small" text="CURRENT BID" />
                                                <Label fx:id="CurrentHighestBidValue" styleClass="price-label" text="7,000,000$" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label styleClass="label-small" text="BUY IT NOW" />
                                                <Label fx:id="MaxPriceValue" styleClass="price-label" text="NO BUY IT NOW" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label styleClass="label-small" text="ENDS IN" />
                                        <Label fx:id="EndsInValue" styleClass="timer-label" text="22h 12m" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <Button fx:id="BidButton" maxWidth="Infinity" onAction="#showbiddingform" prefHeight="65.0" styleClass="bid-button" text="PLACE BID NOW" />

                        <HBox spacing="10" alignment="CENTER">
                            <children>
                                <TextField fx:id="autobidfield" promptText="Max Auto-Bid $" styleClass="search-input" prefHeight="45.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1a2e; -fx-text-fill: white; -fx-border-color: #e2b44d; -fx-border-radius: 5;"/>
                                <Button fx:id="autobidbutton" onAction="#handleautobid" prefHeight="45.0" text="AUTO BID" style="-fx-background-color: #e2b44d; -fx-text-fill: #1a1a2e; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;" />
                            </children>
                        </HBox>

                        <Button fx:id="RateButton" maxWidth="Infinity" onAction="#showratingform" prefHeight="50.0" text="RATE THIS TRANSACTION" visible="false" managed="false" style="-fx-background-color: #e2b44d; -fx-text-fill: #1a1a2e; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand; -fx-background-radius: 8;" />

                        <VBox fx:id="RatingsContainer" spacing="8.0" visible="false" managed="false">
                            <children>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="RATINGS" style="-fx-text-fill: #e2b44d; -fx-font-size: 14; -fx-font-weight: bold;" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <ComboBox fx:id="RatingFilterCombo" onAction="#handleratingfilter" prefWidth="130" style="-fx-background-color: #16213e; -fx-text-fill: white; -fx-font-size: 12;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="REAL-TIME PRICE CURVE" style="-fx-text-fill: #e2b44d; -fx-font-size: 14; -fx-font-weight: bold;" />
                                <LineChart fx:id="pricechart" prefHeight="200.0" animated="false" style="-fx-background-color: transparent;">
                                    <xAxis><CategoryAxis label="Time" animated="false" tickLabelFill="white"/></xAxis>
                                    <yAxis><NumberAxis label="Price ($)" animated="false" tickLabelFill="white"/></yAxis>
                                </LineChart>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
        </HBox>
    </content>
</ScrollPane>