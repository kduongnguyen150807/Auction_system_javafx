<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.ui.RatingForm.RatingFormController" fx:id="RootPane"
      style="-fx-background-color: rgba(0,0,0,0.5);">
    <children>
        <VBox maxWidth="500" maxHeight="380" prefWidth="500" prefHeight="380" spacing="15"
              style="-fx-background-color: #1a1a2e; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e2b44d; -fx-border-width: 2;">
            <padding><Insets left="30" right="30" top="25" bottom="25"/></padding>
            <children>
                <Label text="RATE THIS TRANSACTION"
                       style="-fx-text-fill: #e2b44d; -fx-font-size: 18; -fx-font-weight: bold;" />

                <Label text="Your Rating:" style="-fx-text-fill: white; -fx-font-size: 14;" />
                <HBox fx:id="StarContainer" spacing="8" alignment="CENTER_LEFT" />

                <Label text="Feedback (optional):" style="-fx-text-fill: white; -fx-font-size: 14;" />
                <TextArea fx:id="FeedbackField" promptText="Write your feedback here..."
                          prefHeight="100" wrapText="true"
                          style="-fx-control-inner-background: #16213e; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-font-size: 13;" />

                <HBox spacing="20" alignment="CENTER_RIGHT">
                    <children>
                        <Hyperlink text="Cancel" onAction="#handleCancel"
                                   style="-fx-text-fill: #999; -fx-font-size: 14;" />
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Submit Rating" onAction="#handleSubmit" prefHeight="40" prefWidth="150"
                                style="-fx-background-color: #e2b44d; -fx-text-fill: #1a1a2e; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand; -fx-background-radius: 8;" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
