<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
            maxWidth="Infinity" maxHeight="Infinity"
            fx:controller="com.auction.client.ui.UserProfile.UserProfileController"
            stylesheets="@/css/userprofile/UserProfile.css">
    <content>
        <VBox spacing="18" styleClass="profile-root">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <Button fx:id="backButton" text="← Back" styleClass="back-btn" onAction="#handleBack"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>

                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="profile-header">
                    <children>
                        <StackPane prefWidth="88" minWidth="88" maxWidth="88" prefHeight="88" alignment="CENTER">
                            <children>
                                <Circle radius="34" styleClass="profile-avatar"/>
                                <ImageView fx:id="avatarImageView" fitWidth="68" fitHeight="68"/>
                            </children>
                        </StackPane>
                        <VBox spacing="4">
                            <children>
                                <Label fx:id="usernameLabel" text="username" styleClass="profile-title"/>
                                <Label fx:id="fullNameLabel" text="" styleClass="profile-subtitle"/>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="ratingStarsLabel" text="" style="-fx-text-fill: #e2b44d; -fx-font-size: 16;"/>
                                        <Label fx:id="ratingCountLabel" text="" style="-fx-text-fill: #999; -fx-font-size: 12;"/>
                                    </children>
                                </HBox>
                                <Label fx:id="reputationWarning" text="" style="-fx-text-fill: #ff4444; -fx-font-weight: bold; -fx-font-size: 13;" visible="false" managed="false"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Label text="Statistics" styleClass="section-title"/>

                <HBox spacing="14">
                    <children>
                        <VBox HBox.hgrow="ALWAYS" styleClass="metric-card" spacing="8" alignment="CENTER_LEFT">
                            <children>
                                <Label text="ITEMS BOUGHT" styleClass="metric-title-sm"/>
                                <Label fx:id="itemsBoughtLabel" text="0" styleClass="metric-value-sm"/>
                            </children>
                            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" styleClass="metric-card" spacing="8" alignment="CENTER_LEFT">
                            <children>
                                <Label text="ITEMS SOLD" styleClass="metric-title-sm"/>
                                <Label fx:id="itemsSoldLabel" text="0" styleClass="metric-value-sm"/>
                            </children>
                            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" styleClass="metric-card" spacing="8" alignment="CENTER_LEFT">
                            <children>
                                <Label text="ROLE" styleClass="metric-title-sm"/>
                                <Label fx:id="roleLabel" text="" styleClass="metric-value-role"/>
                            </children>
                            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                        </VBox>
                    </children>
                </HBox>

                <Label text="Contact" styleClass="section-title"/>

                <HBox spacing="14">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="EMAIL" styleClass="field-label"/>
                                <Label fx:id="emailLabel" text="" styleClass="field-box"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Label text="Seller Listings" styleClass="section-title"/>
                <FlowPane fx:id="itemsContainer" hgap="12" vgap="12" prefWrapLength="900"/>

            </children>
            <padding><Insets top="26" right="24" bottom="24" left="24"/></padding>
        </VBox>
    </content>
</ScrollPane>
