<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.ui.WorldChat.WorldChatController"
            prefHeight="400.0" prefWidth="600.0">
    <children>
        <VBox alignment="BOTTOM_CENTER" layoutX="220" layoutY="0">
            <children>
                <VBox fx:id="ChatContainer" alignment="TOP_LEFT" prefHeight="400">
                    <children>
                    </children>
                </VBox>
                <TextField fx:id="MessageField" promptText="Type shit"/>
                <Button text="Send Message" onAction="#SendMessage"/>
            </children>
        </VBox>
    </children>
</VBox>
