<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import com.auction.client.ui.component.IntegerField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<fx:root type="StackPane" fx:id="RootPane" alignment="CENTER" prefHeight="768.0" prefWidth="1024.0"
         style="-fx-background-color: transparent;"
         stylesheets="/css/biddingform/BiddingForm.css"
         xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox alignment="TOP_CENTER" maxHeight="480.0" maxWidth="720.0" spacing="30.0" styleClass="glass-panel-bid">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox>
                            <children>
                                <Label styleClass="form-brand-mac" text="BIDDING88" />
                                <Label styleClass="form-header-mac" text="PLACE YOUR BID" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="25.0">
                    <children>
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="field-label-bright" text="ITEM NUMBER" />
                                <Label fx:id="itemId" styleClass="info-box-opaque" text="#ID" maxWidth="Infinity"/>
                            </children>
                        </VBox>
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="field-label-bright" text="ITEM NAME" />
                                <Label fx:id="itemName" styleClass="info-box-opaque" text="Item Name" maxWidth="Infinity"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="15.0">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label styleClass="field-label-bright" text="ENTER YOUR BID AMOUNT ($)" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="maxPriceInfo" styleClass="buy-now-hint" text="Buy Now: $0.00" />
                            </children>
                        </HBox>
                        <IntegerField fx:id="bidAmount" prefHeight="90.0" promptText="Enter amount (e.g. 1500)" styleClass="input-bid-solid" />
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="30.0">
                    <children>
                        <Hyperlink fx:id="CancelBidding" onAction="#handleCancel" styleClass="link-cancel-mac" text="Cancel" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="ConfirmBidding" onAction="#handleConfirm" prefHeight="55.0" prefWidth="200.0" styleClass="btn-confirm-glow" text="CONFIRM BID" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="45.0" left="45.0" right="45.0" top="40.0" />
            </padding>
        </VBox>
    </children>
</fx:root>