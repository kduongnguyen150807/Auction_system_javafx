<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<fx:root type="VBox" fx:id="itemRoot" alignment="TOP_CENTER"
      spacing="0.0" styleClass="glass-card-item"
      stylesheets="@../../css/itemcard/ItemCard.css" maxHeight="150" maxWidth="100"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <StackPane styleClass="image-container-mac">
            <children>
                <ImageView fx:id="imageHolder" fitHeight="240.0" fitWidth="270.0" pickOnBounds="true" preserveRatio="true">
                    <clip>
                        <Rectangle fx:id="imageClip" arcHeight="30.0" arcWidth="30.0" height="240.0" width="270.0" />
                    </clip>
                </ImageView>

                <!-- TÍNH NĂNG WATCHLIST: Nút thả tim góc trên bên phải ảnh -->
                <Label fx:id="heartIcon" text="🤍" StackPane.alignment="TOP_RIGHT"
                       style="-fx-font-size: 24px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 5, 0, 0, 2);">
                    <StackPane.margin>
                        <Insets top="10.0" right="10.0" />
                    </StackPane.margin>
                </Label>
            </children>
            <VBox.margin><Insets bottom="15.0" left="10.0" right="10.0" top="10.0" /></VBox.margin>
        </StackPane>

        <VBox spacing="12.0">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label fx:id="itemName" styleClass="item-name-mac" text="Product Name" wrapText="true" />
                        <Label fx:id="itemDescription" styleClass="item-desc-mac" text="Minimalist description..." wrapText="false" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="0.0">
                    <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="priceMetricCaption" styleClass="label-sm-gray" text="CURRENT BID" />
                                <Label fx:id="price" styleClass="price-val-cyan" text="0$" />
                            </children>
                        </VBox>
                        <VBox alignment="TOP_RIGHT" spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="label-sm-gray" text="TIME LEFT" />
                                <Label fx:id="timeRemain" styleClass="timer-val-orange" text="00:00:00" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox fx:id="sellerActionsRow" alignment="CENTER" spacing="8.0" managed="false" visible="false">
                    <children>
                        <Button fx:id="btnEditMyItem" mnemonicParsing="false" styleClass="btn-seller-item" text="Chỉnh sửa" />
                        <Button fx:id="btnDeleteMyItem" mnemonicParsing="false" styleClass="btn-seller-item" text="Hủy / Xóa" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="5.0" />
            </padding>
        </VBox>
    </children>
</fx:root>