<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<fx:root type="VBox"
         xmlns="http://javafx.com/javafx/25"
         xmlns:fx="http://javafx.com/fxml/1"
         stylesheets="@../../css/component/ListPane.css">
    <children>
        <Label fx:id="lotsName"
               text="Art Lots"
               styleClass="category-heading"/>
        <ScrollPane fx:id="scrollPane"
                    hbarPolicy="NEVER"
                    vbarPolicy="NEVER">
            <content>
                <HBox fx:id="listRow"
                      alignment="CENTER_LEFT"
                      spacing="16.0"
                      styleClass="category-row"/>
            </content>
        </ScrollPane>

    </children>

</fx:root>