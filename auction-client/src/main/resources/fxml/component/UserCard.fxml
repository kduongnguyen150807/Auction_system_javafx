<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<fx:root type="HBox" xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         alignment="CENTER_LEFT" spacing="25.0">
    <children>
        <VBox alignment="CENTER" spacing="12.0">
            <children>
                <StackPane prefHeight="100.0" prefWidth="100.0">
                    <children>
                        <Circle radius="45.0" stroke="WHITE" strokeType="INSIDE"
                                strokeWidth="2.0"
                                style="-fx-fill: rgba(255,255,255,0.1); -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 5);"/>
                        <ImageView fx:id="avatarImageView" fitHeight="86.0" fitWidth="86.0"
                                   pickOnBounds="true" preserveRatio="true"/>
                    </children>
                </StackPane>
            </children>
        </VBox>

        <VBox alignment="CENTER_LEFT" spacing="8.0" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label fx:id="userNameLabel" text="username" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="32.0"/>
                            </font>
                        </Label>
                        <Label fx:id="verifiedLabel" styleClass="badge-verified"
                               text="Verified"/>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label fx:id="ratingStarsLabel" styleClass="stars-glow" text="★★★★★"/>
                        <Label fx:id="ratingCountLabel" style="-fx-text-fill: #cccccc;"
                               text="(0 đánh giá)"/>
                    </children>
                </HBox>
                <Label fx:id="reputationWarning" managed="false"
                       style="-fx-text-fill: #ff4d4d; -fx-font-weight: bold; -fx-font-size: 14px;"
                       text="Cảnh báo uy tín!" visible="false"/>
            </children>
        </VBox>
    </children>
</fx:root>
