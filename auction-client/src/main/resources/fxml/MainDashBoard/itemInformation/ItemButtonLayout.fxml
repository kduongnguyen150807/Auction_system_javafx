<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox
         xmlns="http://javafx.com/javafx/25"
         xmlns:fx="http://javafx.com/fxml/1"
         spacing="20"
         alignment="TOP_CENTER" styleClass="main-container"
         prefWidth="300"
         fx:controller="com.auction.client.ui.maindashboard.itemInformation.ItemButtonLayoutController">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <children>

        <Button fx:id="bidButton"
                text="PLACE BID NOW"
                prefHeight="60"
                maxWidth="Infinity"
                onAction="#handleBid"
                styleClass="bid-button" />

        <HBox spacing="10">

            <children>

                <TextField fx:id="autoBidField"
                           promptText="Max Auto-Bid $"
                           HBox.hgrow="ALWAYS"
                           prefHeight="45"
                           styleClass="bid-input" />

                <Button fx:id="autoBidButton"
                        text="AUTO BID"
                        prefWidth="120"
                        prefHeight="45"
                        onAction="#handleAutoBid"
                        styleClass="gold-button" />

            </children>

        </HBox>

        <Button fx:id="rateButton"
                text="RATE TRANSACTION"
                prefHeight="50"
                maxWidth="Infinity"
                visible="false"
                managed="false"
                onAction="#handleRate"
                styleClass="gold-button" />

    </children>

</VBox>