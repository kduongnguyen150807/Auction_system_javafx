<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.ui.maindashboard.admin.PendingItemController"
      styleClass="dashboard-section">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT"
          spacing="10">

        <Label text="PENDING ITEMS"
               styleClass="section-title"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Refresh"
                onAction="#handleRefresh"
                styleClass="secondary-button"/>

    </HBox>

    <!-- Table -->
    <TableView fx:id="pendingTable"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="itemNameColumn"
                         text="Item Name"
                         prefWidth="200"/>

            <TableColumn fx:id="sellerColumn"
                         text="Seller"
                         prefWidth="140"/>

            <TableColumn fx:id="categoryColumn"
                         text="Category"
                         prefWidth="130"/>

            <TableColumn fx:id="startingPriceColumn"
                         text="Starting Price"
                         prefWidth="140"/>

            <TableColumn fx:id="conditionColumn"
                         text="Condition"
                         prefWidth="120"/>

            <TableColumn fx:id="createdAtColumn"
                         text="Created At"
                         prefWidth="180"/>

        </columns>

    </TableView>

    <!-- Footer Buttons -->
    <HBox alignment="CENTER"
          spacing="15">

        <Button fx:id="approveButton"
                text="Approve"
                onAction="#handleApprove"
                styleClass="success-button"/>

        <Button fx:id="rejectButton"
                text="Reject"
                onAction="#handleReject"
                styleClass="danger-button"/>

        <Button fx:id="viewDetailButton"
                text="View Detail"
                onAction="#handleViewDetail"
                styleClass="primary-button"/>

    </HBox>

</VBox>