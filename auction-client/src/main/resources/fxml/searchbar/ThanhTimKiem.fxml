<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="1024.0" spacing="15.0" styleClass="search-bar-container" stylesheets="/css/searchbar/ThanhTimKiem.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.ui.SearchBar.ThanhTimKiemController">
    <children>
        <Button fx:id="bellButton" onAction="#toggleNotifications" styleClass="bell-btn" text="🔔" />

        <TextField fx:id="searchField" maxWidth="800.0" prefHeight="42.0" promptText="Tìm kiếm..." styleClass="search-input" HBox.hgrow="ALWAYS" />

        <HBox alignment="CENTER" spacing="0.0" styleClass="search-toggle-group">
            <children>
                <ToggleButton fx:id="itemsToggle" onAction="#onSearchModeChanged" prefHeight="42.0" prefWidth="90.0" styleClass="search-toggle, search-toggle-left" text="Items">
                    <toggleGroup>
                        <ToggleGroup fx:id="searchModeGroup" />
                    </toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="usersToggle" onAction="#onSearchModeChanged" prefHeight="42.0" prefWidth="90.0" styleClass="search-toggle, search-toggle-right" text="Users">
                    <toggleGroup>
                        <fx:reference source="searchModeGroup" />
                    </toggleGroup>
                </ToggleButton>
            </children>
        </HBox>

        <ComboBox fx:id="categoryFilter" prefHeight="42.0" prefWidth="160.0" promptText="Danh mục" styleClass="category-filter" />

        <TextField fx:id="minpricefield" prefHeight="42.0" prefWidth="90.0" promptText="Min $" styleClass="search-input" />
        <TextField fx:id="maxpricefield" prefHeight="42.0" prefWidth="90.0" promptText="Max $" styleClass="search-input" />

        <Button fx:id="filterButton" onAction="#applyFilter" prefHeight="42.0" styleClass="btn-apply" text="Apply" />
    </children>
</HBox>