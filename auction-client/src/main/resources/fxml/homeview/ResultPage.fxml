<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import com.auction.client.ui.homeview.homeviewcomponent.ReactiveFlowPane?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane"
            stylesheets="@/css/homeview/ResultPage.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.ui.homeview.controller.ResultPageController">
    <content>
        <VBox alignment="TOP_CENTER" style="-fx-background-color: transparent;">
            <children>
                <VBox maxWidth="1000.0" spacing="30.0" styleClass="glass-panel-item">
                    <children>
                        <VBox spacing="15.0">
                            <children>
                                <ReactiveFlowPane fx:id="itemContainer" hgap="20.0" vgap="20.0" />
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="40.0" top="40.0" />
                    </VBox.margin>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>