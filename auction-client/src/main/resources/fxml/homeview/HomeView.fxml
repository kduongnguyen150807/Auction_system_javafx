<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<fx:root minHeight="1024.0" minWidth="1280.0" prefHeight="768.0" prefWidth="1024.0"
         type="HBox" xmlns:fx="http://javafx.com/fxml">
    <children>
        <VBox fx:id="sideBar" prefWidth="256.0" minWidth="256.0" />
        <VBox HBox.hgrow="ALWAYS">
            <children>
                <HBox fx:id="searchContainer" prefHeight="70.0" minHeight="70.0" alignment="CENTER_LEFT" styleClass="search-bar-glass" spacing="15.0">
                    <children>
                        <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh" styleClass="btn-primary"/>
                    </children>
                    <VBox.margin><Insets top="20.0" left="20.0" right="20.0" bottom="10.0"/></VBox.margin>
                    <padding><Insets left="20.0" right="20.0"/></padding>
                </HBox>
                <StackPane fx:id="contentPanel" HBox.hgrow="ALWAYS"/>
            </children>
        </VBox>
    </children>
</fx:root>