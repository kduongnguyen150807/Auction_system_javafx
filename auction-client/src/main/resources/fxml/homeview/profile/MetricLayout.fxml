<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import com.auction.client.ui.component.MetricCard?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.ui.homeview.controller.profile.MetricLayoutController"
      spacing="20">
    <children>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <children>
                <Region style="-fx-background-color: rgba(255,255,255,0.1); -fx-pref-height: 1;"/>
                <Label style="-fx-text-fill: #cccccc;" text="Vai trò hiện tại:"/>
                <Label fx:id="roleLabel" styleClass="badge-role" text="Bidder"/>
                <Button fx:id="toggleRoleButton" mnemonicParsing="false"
                        onAction="#handleToggleRole" styleClass="btn-mac-rounded"
                        text="Đổi sang Seller" />
            </children>
        </HBox>

        <HBox fx:id="bidderMetricsRow" spacing="20.0">
            <children>
                <MetricCard fx:id="moneySpentMetric" HBox.hgrow="ALWAYS" title="TIỀN ĐÃ TIÊU"/>
                <MetricCard fx:id="itemsBoughtMetric" HBox.hgrow="ALWAYS" title="SẢN PHẨM ĐÃ MUA"/>
            </children>
        </HBox>

        <HBox fx:id="sellerMetricsRow" managed="false" spacing="20.0" visible="false">
            <children>
                <MetricCard fx:id="moneyReceivedMetric" HBox.hgrow="ALWAYS" title="DOANH THU"/>
                <MetricCard fx:id="itemsSoldMetric" HBox.hgrow="ALWAYS" title="SẢN PHẨM ĐÃ BÁN"/>
            </children>
        </HBox>

    </children>
</VBox>
