<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<?import com.auction.client.ui.component.UserCard?>
<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxHeight="Infinity" maxWidth="Infinity"
            styleClass="scroll-pane" stylesheets="@../../../css/profile/Profile.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.ui.homeview.controller.profile.ProfileController">
    <content>
        <VBox alignment="TOP_CENTER" styleClass="profile-root">
            <children>
                <VBox maxWidth="850.0" spacing="25.0" styleClass="glass-panel">
                    <children>
                        <HBox>
                            <children>
                                <VBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                        <UserCard fx:id="userCard"/>
                                        <Button mnemonicParsing="false" onAction="#handleChangeAvatar"
                                                styleClass="btn-mac-rounded" text="Đổi Avatar"/>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button mnemonicParsing="false" onAction="#handleLogout" prefWidth="130.0"
                                        styleClass="btn-logout-red" text="Đăng xuất"/>
                            </children>
                        </HBox>

                        <fx:include source="MetricLayout.fxml" fx:id="metricLayout"/>

                        <VBox spacing="20.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="Thông tin cá nhân" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="22.0"/>
                                            </font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                                <fx:include source="IdentityLayout.fxml" fx:id="identityLayout"/>
                            </children>
                        </VBox>
                        <Region style="-fx-background-color: rgba(255,255,255,0.1); -fx-pref-height: 1;"/>
                        <fx:include source="WalletLayout.fxml" fx:id="walletLayout"/>
                    </children>
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
                    </padding>
                    <VBox.margin>
                        <Insets bottom="40.0" top="40.0"/>
                    </VBox.margin>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
