<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>

<VBox alignment="CENTER" spacing="10.0"
      style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-padding: 20;"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.ui.homeview.controller.admin.AdminDashboardController">

    <fx:include source="UserManagement.fxml" fx:id="userManagement" />

    <fx:include source="ItemManagement.fxml" fx:id="itemManagement" />

    <Label text="SYSTEM ANALYTICS" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-padding: 15 0 0 0;"/>
    <HBox alignment="CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
        <PieChart fx:id="statusChart" title="Item Status" prefHeight="250.0" prefWidth="350.0"/>
        <BarChart fx:id="categoryChart" title="Revenue by Category" prefHeight="250.0" prefWidth="450.0">
            <xAxis>
                <CategoryAxis label="Category"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Revenue ($)"/>
            </yAxis>
        </BarChart>
    </HBox>
</VBox>