<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.ui.homeview.controller.admin.UserManagementController"
      prefHeight="400.0" prefWidth="600.0">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <Label text="USER MANAGEMENT" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Filter by rating:" style="-fx-font-size: 12;"/>
            <ComboBox fx:id="ratingBox" prefWidth="140.0"/>
        </HBox>
        <TableView fx:id="userTable" prefHeight="200.0" VBox.vgrow="SOMETIMES">
            <columns>
                <TableColumn fx:id="colUsername" text="username" prefWidth="120.0"/>
                <TableColumn fx:id="colEmail" text="email" prefWidth="170.0"/>
                <TableColumn fx:id="colRole" text="role" prefWidth="80.0"/>
                <TableColumn fx:id="colStatus" text="status" prefWidth="80.0"/>
                <TableColumn fx:id="colRating" text="rating" prefWidth="80.0"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER" spacing="20.0">
            <Button fx:id="btnban" mnemonicParsing="false" onAction="#handleBan"
                    style="-fx-background-color: red; -fx-text-fill: white;" text="Ban User"/>
            <Button fx:id="btnunban" mnemonicParsing="false" onAction="#handleUnban"
                    style="-fx-background-color: green; -fx-text-fill: white;" text="Unban User"/>
            <Button mnemonicParsing="false" onAction="#handlePromoteAdmin"
                    style="-fx-background-color: #9C27B0; -fx-text-fill: white;" text="Toggle Admin"/>
        </HBox>
    </children>
</VBox>
