<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="768.0" prefWidth="1024.0" style="-fx-background-color: transparent;" stylesheets="/css/addnewlot/AddNewLot.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.ui.homeview.controller.AddNewLotController">
    <children>
        <ScrollPane
                fitToWidth="true"
                fitToHeight="false"
                hbarPolicy="AS_NEEDED"
                vbarPolicy="AS_NEEDED"
                styleClass="scroll-pane addnewlot-scroll"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.topAnchor="0.0">
            <content>
                <StackPane>
                    <padding>
                        <Insets top="30.0" bottom="30.0" left="40.0" right="40.0" />
                    </padding>
                    <children>
                        <VBox alignment="CENTER" maxWidth="940.0" spacing="15.0" styleClass="glass-panel-item-blue">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <VBox>
                                            <children>
                                                <Label styleClass="form-sub-title-mac" text="BIDDING88" />
                                                <Label fx:id="formTitleLabel" styleClass="form-title-mac" text="ADD NEW ITEM" />
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <HBox alignment="TOP_CENTER" spacing="35.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <VBox alignment="TOP_CENTER" prefWidth="300.0" spacing="15.0">
                                            <children>
                                                <StackPane prefHeight="200.0" prefWidth="300.0" styleClass="image-frame-mac">
                                                    <children>
                                                        <ImageView fx:id="productImageView" fitHeight="180.0" fitWidth="280.0" pickOnBounds="true" preserveRatio="true" />
                                                    </children>
                                                </StackPane>
                                                <Button maxWidth="Infinity" onAction="#handleChoosePicture" styleClass="btn-secondary-mac" text="CHOOSE PICTURE" />
                                                <Label fx:id="lblStatus" alignment="CENTER" maxWidth="Infinity" styleClass="status-label" wrapText="true" />
                                            </children>
                                        </VBox>

                                        <VBox prefWidth="480.0" maxWidth="Infinity" spacing="10.0">
                                            <children>
                                                <TextField fx:id="txtName" promptText="PRODUCT NAME" styleClass="input-mac-blue" />

                                                <Label styleClass="label-sm" text="AUCTION FORMAT" />
                                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10.0" styleClass="auction-type-segments">
                                                    <children>
                                                        <ToggleButton fx:id="kindEnglishToggle" maxWidth="Infinity" mnemonicParsing="false" styleClass="segment-toggle-auction" text="English auction" HBox.hgrow="ALWAYS" />
                                                        <ToggleButton fx:id="kindDutchToggle" maxWidth="Infinity" mnemonicParsing="false" styleClass="segment-toggle-auction" text="Dutch auction" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>

                                                <HBox spacing="10.0">
                                                    <children>
                                                        <TextField fx:id="txtPrice" promptText="START PRICE ($)" styleClass="input-mac-blue" HBox.hgrow="ALWAYS" />
                                                        <TextField fx:id="txtMaxPrice" promptText="BUY NOW ($)" styleClass="input-mac-blue" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>

                                                <VBox fx:id="dutchExtrasVBox" spacing="10.0" managed="false" visible="false">
                                                    <children>
                                                        <TextField fx:id="txtDutchReservePrice" promptText="RESERVE / MIN PRICE ($)" styleClass="input-mac-blue" />
                                                        <HBox spacing="10.0">
                                                            <children>
                                                                <TextField fx:id="txtDutchDecrement" promptText="PRICE STEP DOWN ($)" styleClass="input-mac-blue" HBox.hgrow="ALWAYS" />
                                                                <TextField fx:id="txtDutchIntervalMinutes" promptText="INTERVAL (MINUTES)" styleClass="input-mac-blue" HBox.hgrow="ALWAYS" />
                                                            </children>
                                                        </HBox>
                                                        <Label styleClass="label-sm-muted" maxWidth="Infinity"
                                                               text="Dutch auctions lower the listing by the step amount each interval until someone buys at the current price or the reserve/end is reached." wrapText="true" />
                                                    </children>
                                                </VBox>

                                                <TextArea fx:id="txtQuantity" prefRowCount="2" promptText="DESCRIPTION" styleClass="input-mac-blue" wrapText="true" />

                                                <Label styleClass="label-sm" text="AUCTION START" />
                                                <DatePicker fx:id="startDatePicker" maxWidth="Infinity" promptText="START DATE" styleClass="date-mac" />
                                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="8.0">
                                                    <children>
                                                        <ComboBox fx:id="startHourCombo" minWidth="70.0" promptText="HH" styleClass="combo-mac" HBox.hgrow="ALWAYS" />
                                                        <ComboBox fx:id="startMinuteCombo" minWidth="70.0" promptText="MM" styleClass="combo-mac" HBox.hgrow="ALWAYS" />
                                                        <ComboBox fx:id="startSecondCombo" minWidth="70.0" promptText="SS" styleClass="combo-mac" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>

                                                <Label styleClass="label-sm" text="AUCTION END" />
                                                <DatePicker fx:id="endDatePicker" maxWidth="Infinity" promptText="END DATE" styleClass="date-mac" />
                                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="8.0">
                                                    <children>
                                                        <ComboBox fx:id="endHourCombo" minWidth="70.0" promptText="HH" styleClass="combo-mac" HBox.hgrow="ALWAYS" />
                                                        <ComboBox fx:id="endMinuteCombo" minWidth="70.0" promptText="MM" styleClass="combo-mac" HBox.hgrow="ALWAYS" />
                                                        <ComboBox fx:id="endSecondCombo" minWidth="70.0" promptText="SS" styleClass="combo-mac" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>

                                                <ComboBox fx:id="classifyComboBox" maxWidth="Infinity" promptText="SELECT CATEGORY" styleClass="combo-mac" />

                                                <HBox spacing="15.0">
                                                    <children>
                                                        <Button maxWidth="Infinity" onAction="#handleCancel" styleClass="btn-cancel-mac" text="CANCEL" HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="confirmSubmitButton" maxWidth="Infinity" onAction="#handleSubmit" styleClass="btn-primary-mac" text="CONFIRM UPLOAD" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                    <padding><Insets top="5.0" /></padding>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                            <padding>
                                <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
                            </padding>
                        </VBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>