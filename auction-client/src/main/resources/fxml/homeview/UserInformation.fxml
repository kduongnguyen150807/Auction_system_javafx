<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<?import com.auction.client.ui.component.UserCard?>
<?import com.auction.client.ui.homeview.homeviewcomponent.ReactiveFlowPane?>
<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            stylesheets="/css/userprofile/UserProfile.css" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.ui.homeview.controller.UserInformationController">
    <content>
        <VBox alignment="TOP_CENTER" styleClass="profile-root">
            <children>
                <VBox maxWidth="900.0" spacing="25.0" styleClass="glass-panel-user">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label styleClass="section-title" text="User Information"/>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="30.0" styleClass="info-header">
                            <children>
                                <UserCard fx:id="userCard" />
                            </children>
                        </HBox>

                        <HBox spacing="20.0">
                            <children>
                                <VBox alignment="CENTER_LEFT" spacing="8.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-title-sm" text="ITEMS BOUGHT"/>
                                        <Label fx:id="itemsBoughtLabel" styleClass="stat-value-pink" text="0"/>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER_LEFT" spacing="8.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-title-sm" text="ITEMS SOLD"/>
                                        <Label fx:id="itemsSoldLabel" styleClass="stat-value-pink" text="0"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="10.0">
                            <children>
                                <Label styleClass="field-label" text="EMAIL ADDRESS"/>
                                <Label fx:id="emailLabel" styleClass="field-box-mac" text="email@example.com"/>
                            </children>
                        </VBox>

                        <VBox spacing="15.0">
                            <children>
                                <Label styleClass="section-subtitle" text="Seller Listings"/>
                                <ReactiveFlowPane fx:id="itemsContainer" hgap="20.0" prefWrapLength="850.0" vgap="20.0"/>
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
                    </padding>
                </VBox>
            </children>
            <padding>
                <Insets bottom="30.0" top="30.0"/>
            </padding>
        </VBox>
    </content>
</ScrollPane>