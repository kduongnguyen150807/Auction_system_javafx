<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>

<VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-padding: 20;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.ui.Main.AdminDashboardController">

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label text="USER MANAGEMENT" style="-fx-font-size: 16; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Filter by rating:" style="-fx-font-size: 12;" />
        <ComboBox fx:id="ratingfilter" onAction="#handleFilterChange" prefWidth="140.0" />
    </HBox>
    <TableView fx:id="usertable" prefHeight="200.0" VBox.vgrow="SOMETIMES">
        <columns>
            <TableColumn fx:id="colusername" text="username" prefWidth="120.0" />
            <TableColumn fx:id="colemail" text="email" prefWidth="170.0" />
            <TableColumn fx:id="colrole" text="role" prefWidth="80.0" />
            <TableColumn fx:id="colstatus" text="status" prefWidth="80.0" />
            <TableColumn fx:id="colrating" text="rating" prefWidth="80.0" />
        </columns>
    </TableView>
    <HBox alignment="CENTER" spacing="20.0">
        <Button fx:id="btnban" mnemonicParsing="false" onAction="#handleBan" style="-fx-background-color: red; -fx-text-fill: white;" text="Ban User" />
        <Button fx:id="btnunban" mnemonicParsing="false" onAction="#handleUnban" style="-fx-background-color: green; -fx-text-fill: white;" text="Unban User" />
        <Button mnemonicParsing="false" onAction="#handlePromoteAdmin" style="-fx-background-color: #9C27B0; -fx-text-fill: white;" text="Toggle Admin" />
    </HBox>

    <Label text="PENDING ITEMS (Awaiting Approval)" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-padding: 15 0 0 0;" />
    <TableView fx:id="pendingtable" prefHeight="200.0" VBox.vgrow="SOMETIMES">
        <columns>
            <TableColumn fx:id="colitemname" text="Name" prefWidth="150.0" />
            <TableColumn fx:id="colitemseller" text="Seller" prefWidth="120.0" />
            <TableColumn fx:id="colitemprice" text="Starting Price" prefWidth="100.0" />
            <TableColumn fx:id="colitemcategory" text="Category" prefWidth="100.0" />
        </columns>
    </TableView>
    <HBox alignment="CENTER" spacing="20.0">
        <Button fx:id="btnapprove" mnemonicParsing="false" onAction="#handleApprove" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Approve" />
        <Button fx:id="btnreject" mnemonicParsing="false" onAction="#handleReject" style="-fx-background-color: #FF5722; -fx-text-fill: white;" text="Reject" />
        <Button mnemonicParsing="false" onAction="#handleRefreshPending" style="-fx-background-color: #607D8B; -fx-text-fill: white;" text="Refresh" />
    </HBox>

    <Label text="SYSTEM ANALYTICS" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-padding: 15 0 0 0;" />
    <HBox alignment="CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
        <PieChart fx:id="statuschart" title="Item Status" prefHeight="250.0" prefWidth="350.0" />
        <BarChart fx:id="categorychart" title="Revenue by Category" prefHeight="250.0" prefWidth="450.0">
            <xAxis><CategoryAxis label="Category" /></xAxis>
            <yAxis><NumberAxis label="Revenue ($)" /></yAxis>
        </BarChart>
    </HBox>

</VBox>