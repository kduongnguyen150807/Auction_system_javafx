<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>

<fx:root type="HBox" alignment="CENTER_LEFT" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefHeight="70.0" spacing="15.0" style="-fx-background-color: transparent;" stylesheets="/css/searchbar/ThanhTimKiem.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" >
    <children>
        <TextField fx:id="searchField" maxWidth="Infinity" prefHeight="42.0" promptText="Tìm kiếm..." styleClass="search-input" HBox.hgrow="ALWAYS" />
        <Button fx:id="applyButton" onAction="#handleApply" prefHeight="42.0" prefWidth="100" text="Apply" styleClass="btn-apply" />
    </children>
</fx:root>