<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import com.auction.client.ui.component.IntegerField?>
<?import com.auction.client.ui.homeview.homeviewcomponent.RatingBox?>
<?import com.auction.client.ui.homeview.homeviewcomponent.VBoxModel?>
<VBox xmlns="http://javafx.com/javafx" spacing="10"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.ui.homeview.controller.iteminformation.ButtonLayoutController"
      prefHeight="400.0" prefWidth="600.0" >
    <children>
        <Button fx:id="bidButton" maxWidth="Infinity" onAction="#showBiddingForm" prefHeight="60.0" styleClass="btn-bid-main" text="PLACE BID NOW" />

        <HBox fx:id="autoBidHBox" spacing="10" alignment="CENTER">
            <children>
                <IntegerField fx:id="autoBidField" promptText="Max Auto-Bid $" styleClass="input-mac-blue" prefHeight="45.0" HBox.hgrow="ALWAYS" />
                <Button fx:id="autoBidButton" onAction="#handleAutoBid" prefHeight="45.0" prefWidth="120.0" text="AUTO BID" styleClass="btn-rounded-gold-sm" />
            </children>
        </HBox>

        <Button fx:id="rateButton" maxWidth="Infinity" onAction="#showRatingForm" prefHeight="50.0" text="RATE THIS TRANSACTION" styleClass="btn-rounded-gold-sm" />

        <VBox fx:id="ratingsContainer" spacing="8.0">
            <children>
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <children>
                        <Label text="RATINGS" styleClass="label-sm-gray" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="ratingFilterCombo" onAction="#handleRatingFilter" prefWidth="130" styleClass="combo-mac-sm" />
                        <VBoxModel fx:id="ratingsBox" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
