<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.ui.loginview.controller.ForgotPasswordController">
    <children>
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0" styleClass="glass-panel">
                    <children>
                        <Label text="Khôi phục mật khẩu" textFill="WHITE">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>

                        <!-- Bước 1: Nhập Email -->
                        <VBox fx:id="step1Box" spacing="15.0">
                            <children>
                                <TextField fx:id="emailField" promptText="Nhập email đã đăng ký" styleClass="clean-input" />
                                <Button onAction="#handleSendOtp" maxWidth="Infinity" styleClass="btn-primary" text="Gửi mã OTP" />
                            </children>
                        </VBox>

                        <!-- Bước 2: Nhập OTP & Pass mới (Ẩn lúc đầu) -->
                        <VBox fx:id="step2Box" spacing="15.0" visible="false" managed="false">
                            <children>
                                <TextField fx:id="otpField" promptText="Nhập mã OTP 6 số" styleClass="clean-input" />
                                <PasswordField fx:id="newPasswordField" promptText="Mật khẩu mới" styleClass="clean-input" />
                                <PasswordField fx:id="confirmPasswordField" promptText="Xác nhận mật khẩu mới" styleClass="clean-input" />
                                <Button onAction="#handleResetPassword" maxWidth="Infinity" styleClass="btn-primary" text="Đổi mật khẩu" />
                            </children>
                        </VBox>

                        <Label fx:id="messageLabel" textFill="#ffcc00" wrapText="true" textAlignment="CENTER"/>

                        <Button onAction="#backToLogin" styleClass="btn-secondary" text="Quay lại Đăng nhập" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>