<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="false" style="-fx-background-color: #000000;" stylesheets="@/css/history/History.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.ui.History.HistoryController">
    <content>
        <VBox alignment="TOP_LEFT" spacing="10.0" style="-fx-background-color: #000000;">
            <children>
                <AnchorPane style="-fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label layoutX="14.0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="Trending Lots" AnchorPane.bottomAnchor="15.0" AnchorPane.topAnchor="25.0" />
                    </children>
                </AnchorPane>
                <FlowPane fx:id="ongoingcontainer" alignment="TOP_LEFT" hgap="30.0" vgap="30.0" style="-fx-background-color: #1a1a1a;">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                </FlowPane>

                <AnchorPane style="-fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label layoutX="14.0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="New Lots Coming Up!" AnchorPane.bottomAnchor="15.0" AnchorPane.topAnchor="25.0" />
                    </children>
                </AnchorPane>
                <FlowPane fx:id="upcomingcontainer" alignment="TOP_LEFT" hgap="30.0" vgap="30.0" style="-fx-background-color: #1a1a1a;">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                </FlowPane>

                <AnchorPane style="-fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label layoutX="14.0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="Closed Lot" AnchorPane.bottomAnchor="15.0" AnchorPane.topAnchor="25.0" />
                    </children>
                </AnchorPane>
                <FlowPane fx:id="closedcontainer" alignment="TOP_LEFT" hgap="30.0" vgap="30.0" style="-fx-background-color: #1a1a1a;">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                </FlowPane>

                <AnchorPane style="-fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label layoutX="14.0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="Past Bids" AnchorPane.bottomAnchor="15.0" AnchorPane.topAnchor="25.0" />
                    </children>
                </AnchorPane>
                <FlowPane fx:id="pastcontainer" alignment="TOP_LEFT" hgap="30.0" vgap="30.0" style="-fx-background-color: #1a1a1a;">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                </FlowPane>
            </children>
        </VBox>
    </content>
</ScrollPane>