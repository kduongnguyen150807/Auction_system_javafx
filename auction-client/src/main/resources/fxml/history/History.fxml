<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            stylesheets="/css/history/History.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.ui.History.HistoryController">
    <content>
        <VBox alignment="TOP_LEFT" spacing="30.0" styleClass="history-main-container">
            <children>
                <VBox styleClass="history-section-glass">
                    <children>
                        <Label styleClass="section-header-glow" text="Trending Lots" />
                        <FlowPane fx:id="ongoingcontainer" alignment="TOP_LEFT" hgap="25.0" vgap="25.0" styleClass="flow-pane-clean" />
                    </children>
                </VBox>

                <VBox styleClass="history-section-glass">
                    <children>
                        <Label styleClass="section-header-glow" text="New Lots Coming Up!" />
                        <FlowPane fx:id="upcomingcontainer" alignment="TOP_LEFT" hgap="25.0" vgap="25.0" styleClass="flow-pane-clean" />
                    </children>
                </VBox>

                <VBox styleClass="history-section-glass">
                    <children>
                        <Label styleClass="section-header-glow" text="Closed Lot" />
                        <FlowPane fx:id="closedcontainer" alignment="TOP_LEFT" hgap="25.0" vgap="25.0" styleClass="flow-pane-clean" />
                    </children>
                </VBox>

                <VBox styleClass="history-section-glass">
                    <children>
                        <Label styleClass="section-header-glow" text="Past Bids" />
                        <FlowPane fx:id="pastcontainer" alignment="TOP_LEFT" hgap="25.0" vgap="25.0" styleClass="flow-pane-clean" />
                    </children>
                </VBox>
            </children>
            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="30.0" /></padding>
        </VBox>
    </content>
</ScrollPane>