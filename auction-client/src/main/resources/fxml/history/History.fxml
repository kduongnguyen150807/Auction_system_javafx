<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #000000;" stylesheets="@History.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.ui.History.HistoryController">
    <content>
        <VBox spacing="10.0" style="-fx-background-color: #000000;" VBox.vgrow="ALWAYS">
            <children>
                <AnchorPane minHeight="0.0" minWidth="0.0" style="-fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label layoutX="14.0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="Trending Lots" AnchorPane.bottomAnchor="15.0" AnchorPane.topAnchor="25.0" />
                    </children>
                </AnchorPane>
                <VBox alignment="TOP_CENTER" spacing="15.0">
                    <children>
                        <HBox alignment="CENTER" fillHeight="false" minHeight="-Infinity" prefHeight="480.0" style="-fx-background-color: #1a1a1a;" styleClass="Row" VBox.vgrow="ALWAYS">
                            <children>
                                <FlowPane fx:id="ongoingcontainer" alignment="TOP_CENTER" hgap="30.0" prefWidth="200.0" vgap="30.0" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="30.0" top="30.0" />
                    </padding>
                </VBox>

                <AnchorPane minHeight="0.0" minWidth="0.0" style="-fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label layoutX="14.0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="New Lots Coming Up!" AnchorPane.bottomAnchor="15.0" AnchorPane.topAnchor="25.0" />
                    </children>
                </AnchorPane>
                <VBox alignment="TOP_CENTER" spacing="15.0">
                    <children>
                        <HBox alignment="CENTER" fillHeight="false" minHeight="-Infinity" prefHeight="480.0" style="-fx-background-color: #1a1a1a;" styleClass="Row" VBox.vgrow="ALWAYS">
                            <children>
                                <FlowPane fx:id="upcomingcontainer" alignment="TOP_CENTER" hgap="30.0" prefWidth="200.0" vgap="30.0" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="30.0" top="30.0" />
                    </padding>
                </VBox>

                <AnchorPane minHeight="0.0" minWidth="0.0" style="-fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label layoutX="14.0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="Closed Lot" AnchorPane.bottomAnchor="15.0" AnchorPane.topAnchor="25.0" />
                    </children>
                </AnchorPane>
                <VBox alignment="TOP_CENTER" spacing="15.0">
                    <children>
                        <HBox alignment="CENTER" fillHeight="false" minHeight="-Infinity" prefHeight="480.0" style="-fx-background-color: #1a1a1a;" styleClass="Row" VBox.vgrow="ALWAYS">
                            <children>
                                <FlowPane fx:id="closedcontainer" alignment="TOP_CENTER" hgap="30.0" prefWidth="200.0" vgap="30.0" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="30.0" top="30.0" />
                    </padding>
                </VBox>

                <AnchorPane minHeight="0.0" minWidth="0.0" style="-fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label layoutX="14.0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="Past Bids" AnchorPane.bottomAnchor="15.0" AnchorPane.topAnchor="25.0" />
                    </children>
                </AnchorPane>
                <VBox alignment="TOP_CENTER" spacing="15.0">
                    <children>
                        <HBox alignment="CENTER" fillHeight="false" minHeight="-Infinity" prefHeight="480.0" style="-fx-background-color: #1a1a1a;" styleClass="Row" VBox.vgrow="ALWAYS">
                            <children>
                                <FlowPane fx:id="pastcontainer" alignment="TOP_CENTER" hgap="30.0" prefWidth="200.0" vgap="30.0" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="30.0" top="30.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>