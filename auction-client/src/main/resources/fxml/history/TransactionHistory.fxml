<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>

<fx:root type="VBox" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      alignment="TOP_CENTER" styleClass="history-root" stylesheets="/css/history/TransactionHistory.css">

    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <children>
        <VBox spacing="25" styleClass="glass-panel-history" maxWidth="1000" VBox.vgrow="ALWAYS">
            <children>
                <Label text="LỊCH SỬ GIAO DỊCH" styleClass="history-title-glow"/>

                <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="transaction-table-glass">
                    <columns>
                        <TableColumn fx:id="idcol" text="MÃ GD" prefWidth="90"/>
                        <TableColumn fx:id="typecol" text="LOẠI GIAO DỊCH" prefWidth="200"/>
                        <TableColumn fx:id="amountcol" text="SỐ TIỀN" prefWidth="160"/>
                        <TableColumn fx:id="itemcol" text="MÃ SP" prefWidth="100"/>
                        <TableColumn fx:id="datecol" text="THỜI GIAN" prefWidth="280"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </children>
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
        </VBox>
    </children>
</fx:root>