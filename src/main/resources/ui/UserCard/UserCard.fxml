<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.ui.UserCard.UserCardController"
      fx:id="userRow" spacing="20" alignment="CENTER_LEFT" styleClass="user-card" focusTraversable="true">
    <children>
        <ImageView fx:id="avatar" fitHeight="45" fitWidth="45"><image><Image url="@../../images/Hutao.png"/> </image></ImageView>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="name" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18;" text="username" />
            <Label fx:id="email" style="-fx-text-fill: #808080; -fx-font-size: 11;" text="abc@mail.com" />
        </VBox>
        <Label fx:id="status" text="VERIFIED" style="-fx-text-fill: #ffcc00; -fx-background-color: #332b00; -fx-padding: 5 10; -fx-background-radius: 15;" />
        <Label fx:id="role" text="Collector" prefWidth="100" style="-fx-text-fill: #b3b3b3;" />
        <Label fx:id="spend" text="248,500$" prefWidth="120" style="-fx-text-fill: white;" />
    </children>
</HBox>
