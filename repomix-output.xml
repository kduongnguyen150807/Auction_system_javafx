/* Các khối nội dung kính mờ */
.metric-card-glass {
    -fx-background-color: rgba(0,0,0,0.4);
    -fx-background-radius: 15;
    -fx-border-color: rgba(255,255,255,0.1);
    -fx-border-radius: 15;
    -fx-padding: 20;
}

.field-box-mac {
    -fx-text-fill: white;
    -fx-padding: 12;
    -fx-background-color: rgba(0,0,0,0.2);
    -fx-background-radius: 10;
    -fx-border-color: rgba(255,255,255,0.05);
}

.clean-input-mac {
    -fx-background-color: rgba(255, 255, 255, 0.1);
    -fx-text-fill: white;
    -fx-background-radius: 12;
    -fx-padding: 10;
}

.wallet-bar-glass {
    -fx-background-color: rgba(255, 204, 0, 0.1);
    -fx-background-radius: 20;
    -fx-border-color: rgba(255, 204, 0, 0.3);
    -fx-padding: 20;
}

.label-sm-gray { -fx-text-fill: #aaaaaa; -fx-font-weight: bold; -fx-font-size: 12px; }

/* Số tiền / số lượng trong thẻ metric — khớp FXML cũ (Font size="26" = 26pt, không phải px) nên dùng pt để giữ đúng “to” như lúc mới mở */
.metric-value-number {
    -fx-font-size: 26pt;
    -fx-font-weight: bold;
}
.metric-money-spent {
    -fx-text-fill: #007aff;
}
.metric-count {
    -fx-text-fill: white;
}
.metric-money-received {
    -fx-text-fill: #34c759;
}
.badge-verified { -fx-background-color: #34c759; -fx-text-fill: white; -fx-padding: 4 12; -fx-background-radius: 15; -fx-font-weight: bold; }
.stars-glow { -fx-text-fill: #ffcc00; -fx-effect: dropshadow(three-pass-box, rgba(255, 204, 0, 0.5), 5, 0, 0, 0); }
</file>

<file path="auction-client/src/main/resources/css/searchbar/ThanhTimKiem.css">
/* ================================================== */
/* THANH CHỨA TỔNG THỂ - ĐÃ BO GÓC 20 VÀ NỔI LỀNH BỀNH */
/* ================================================== */
.search-bar-container {
    -fx-background-color: rgba(30, 30, 30, 0.65); /* Kính mờ sang chảnh */
    -fx-background-radius: 20; /* FIX BO GÓC */
    -fx-border-color: rgba(255, 255, 255, 0.15);
    -fx-border-radius: 20;
    -fx-border-width: 1.5;
    -fx-padding: 12 25;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 15, 0, 0, 5);
}

/* Ô nhập liệu tìm kiếm & khoảng giá */
.search-input {
    -fx-background-color: rgba(0, 0, 0, 0.4);
    -fx-text-fill: white;
    -fx-prompt-text-fill: #999999;
    -fx-background-radius: 12;
    -fx-border-color: rgba(255, 255, 255, 0.1);
    -fx-border-radius: 12;
    -fx-font-family: "Consolas";
    -fx-font-size: 14px;
    -fx-padding: 0 15;
    -fx-transition-duration: 0.3s;
}

.search-input:focused {
    -fx-border-color: #ffaa00;
    -fx-background-color: rgba(0, 0, 0, 0.6);
    -fx-effect: dropshadow(three-pass-box, rgba(255, 170, 0, 0.3), 10, 0, 0, 0);
}

/* ================================================== */
/* COMBOBOX - BO GÓC MƯỢT NHƯ APPLE                   */
/* ================================================== */
.category-filter {
    -fx-background-color: rgba(0, 0, 0, 0.4);
    -fx-background-radius: 12;
    -fx-border-color: rgba(255, 255, 255, 0.15);
    -fx-border-radius: 12;
    -fx-font-family: "Consolas";
    -fx-padding: 0 5;
    -fx-cursor: hand;
    -fx-transition-duration: 0.2s;
}

.category-filter .label { -fx-text-fill: white; }

.category-filter:showing {
    -fx-background-color: #007aff;
    -fx-background-radius: 12 12 0 0;
    -fx-border-radius: 12 12 0 0;
}

.category-filter .list-view {
    -fx-background-color: rgba(25, 25, 25, 0.95);
    -fx-background-radius: 0 0 12 12;
    -fx-border-color: rgba(255, 255, 255, 0.2);
    -fx-border-radius: 0 0 12 12;
    -fx-padding: 5;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 15, 0, 0, 5);
}

.category-filter .list-cell {
    -fx-text-fill: white;
    -fx-background-color: transparent;
    -fx-padding: 8 15;
    -fx-background-radius: 8;
    -fx-font-family: "Consolas";
}

.category-filter .list-cell:hover { -fx-background-color: rgba(255, 255, 255, 0.1); }
.category-filter .list-cell:selected { -fx-background-color: #007aff; -fx-text-fill: white; }
.category-filter .arrow-button { -fx-background-radius: 0 12 12 0; }
.category-filter .arrow-button .arrow { -fx-background-color: white; }

/* Nút chuông thông báo */
.bell-btn {
    -fx-background-color: rgba(255, 255, 255, 0.1);
    -fx-text-fill: white;
    -fx-font-size: 18px;
    -fx-background-radius: 20;
    -fx-min-width: 40px;
    -fx-min-height: 40px;
    -fx-cursor: hand;
    -fx-transition-duration: 0.3s;
    -fx-border-color: transparent;
}

.bell-btn:hover {
    -fx-background-color: rgba(255, 255, 255, 0.25);
    -fx-border-color: rgba(255, 255, 255, 0.4);
    -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.3), 10, 0, 0, 0);
}

/* Nhóm nút Toggle Items/Users */
.search-toggle-group { -fx-padding: 0; }

.search-toggle {
    -fx-background-color: rgba(0, 0, 0, 0.4);
    -fx-text-fill: #aaaaaa;
    -fx-font-size: 14px;
    -fx-font-weight: bold;
    -fx-padding: 8 20;
    -fx-cursor: hand;
    -fx-border-color: rgba(255, 255, 255, 0.1);
    -fx-border-width: 1;
    -fx-font-family: "Consolas";
    -fx-transition-duration: 0.3s;
}

.search-toggle:hover {
    -fx-background-color: rgba(255, 255, 255, 0.15);
    -fx-text-fill: white;
}

.search-toggle-left {
    -fx-background-radius: 12 0 0 12;
    -fx-border-radius: 12 0 0 12;
}

.search-toggle-right {
    -fx-background-radius: 0 12 12 0;
    -fx-border-radius: 0 12 12 0;
}

#itemsToggle:selected {
    -fx-background-color: linear-gradient(to right, #007aff, #00d4ff);
    -fx-text-fill: white;
    -fx-border-color: rgba(255, 255, 255, 0.6);
    -fx-effect: dropshadow(three-pass-box, rgba(0, 122, 255, 0.7), 15, 0, 0, 0);
}

#usersToggle:selected {
    -fx-background-color: linear-gradient(to right, #ff2a6d, #ff7eb3);
    -fx-text-fill: white;
    -fx-border-color: rgba(255, 255, 255, 0.6);
    -fx-effect: dropshadow(three-pass-box, rgba(255, 42, 109, 0.7), 15, 0, 0, 0);
}

/* Nút Apply (Lọc) */
.btn-apply {
    -fx-background-color: linear-gradient(to right, #ffaa00, #ff8c00);
    -fx-text-fill: black;
    -fx-font-weight: bold;
    -fx-background-radius: 12;
    -fx-border-radius: 12;
    -fx-border-color: rgba(255, 255, 255, 0.3);
    -fx-border-width: 1.5;
    -fx-cursor: hand;
    -fx-padding: 0 25;
    -fx-font-family: "Consolas";
    -fx-transition-duration: 0.3s;
    -fx-effect: dropshadow(three-pass-box, rgba(255, 170, 0, 0.4), 10, 0, 0, 0);
}

.btn-apply:hover {
    -fx-background-color: linear-gradient(to right, #ffbb33, #ffaa00);
    -fx-effect: dropshadow(three-pass-box, rgba(255, 170, 0, 0.7), 15, 0, 0, 0);
    -fx-border-color: rgba(255, 255, 255, 0.6);
}
.search-bar-container {
    -fx-background-color: rgba(30, 30, 30, 0.65);
    -fx-background-radius: 20;
    -fx-border-color: rgba(255, 255, 255, 0.15);
    -fx-border-radius: 20;
    -fx-border-width: 1.5;
    -fx-padding: 12 25;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 15, 0, 0, 5);
}
.search-bar-glass {
    -fx-background-color: rgba(30, 30, 30, 0.65);
    -fx-background-radius: 20;
    -fx-border-color: rgba(255, 255, 255, 0.15);
    -fx-border-radius: 20;
    -fx-border-width: 1.5;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 15, 0, 0, 5);
}
</file>

