.root { -fx-font-family: "Consolas"; }

.glass-card-item {
    -fx-background-color: rgba(40, 40, 40, 0.7);
    -fx-background-radius: 25;
    -fx-border-color: rgba(255, 255, 255, 0.1);
    -fx-border-radius: 25;
    -fx-border-width: 1;
    -fx-cursor: hand;
    -fx-transition-duration: 0.3s;
}

.glass-card-item:hover {
    -fx-background-color: rgba(55, 55, 55, 0.85);
    -fx-border-color: #007aff;
    -fx-scale-x: 1.02;
    -fx-scale-y: 1.02;
    -fx-effect: dropshadow(three-pass-box, rgba(0, 122, 255, 0.3), 15, 0, 0, 0);
}

.image-container-mac {
    -fx-background-color: rgba(0, 0, 0, 0.2);
    -fx-background-radius: 20;
}

.item-name-mac { -fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 18px; }
.item-desc-mac { -fx-text-fill: #bbbbbb; -fx-font-size: 13px; }
.label-sm-gray { -fx-text-fill: #888888; -fx-font-size: 10px; -fx-font-weight: bold; }

.price-val-cyan {
    -fx-text-fill: #00E5FF;
    -fx-font-weight: 900;
    -fx-font-size: 20px;
    -fx-effect: dropshadow(three-pass-box, rgba(0, 229, 255, 0.35), 5, 0, 0, 0);
}

.timer-val-orange {
    -fx-text-fill: #ffaa00;
    -fx-font-weight: 900;
    -fx-font-size: 18px;
}

/* Fixed-slot category cards: content stays within narrow column */
.item-card-compact {
    -fx-min-width: 208px;
    -fx-pref-width: 208px;
    -fx-max-width: 208px;
}

.item-card-compact .item-name-mac { -fx-font-size: 14px; }
.item-card-compact .item-desc-mac { -fx-font-size: 10px; -fx-wrap-text: true; }
.item-card-compact .label-sm-gray { -fx-font-size: 9px; }
.item-card-compact .price-val-cyan { -fx-font-size: 17px; }
.item-card-compact .timer-val-orange { -fx-font-size: 15px; }
